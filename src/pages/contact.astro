---
import BaseLayout from '../layouts/BaseLayout.astro';
import SecureContact from '../components/SecureContact.jsx';
---

<BaseLayout
  title="Contact | 0xDelta Research"
  description="Contact 0xDelta Research — reach us via encrypted email with PGP, GitHub, or LinkedIn."
  bodyClass="min-h-screen bg-neutral-950 text-neutral-400 font-mono"
>

    <main class="container mx-auto px-4 py-24 min-h-screen">

      <header class="mb-16 border-b border-neutral-800 pb-12">
        <p class="text-xs font-bold text-neutral-600 mb-6 tracking-[0.2em] uppercase">
            // SECURE_UPLINK
        </p>

        <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 tracking-tighter leading-none uppercase">
            ESTABLISH<br/>CONTACT
        </h1>

        <div class="max-w-2xl border-l-2 border-neutral-800 pl-6">
            <p class="text-lg text-neutral-500 leading-relaxed text-justify">
              Multiple channels available. Reach us via GitHub or LinkedIn for general matters. For sensitive intel or responsible disclosure, use encrypted email only.
            </p>
        </div>
      </header>

      <SecureContact client:visible />

    </main>

</BaseLayout>
