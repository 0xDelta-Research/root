---
import '../styles/global.css';
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';
import SecureContact from '../components/SecureContact.jsx';
---

<html lang="en">
  <head>
    <title>Contact | 0xD3lta Research</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/delta-favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="0xD3lta Research" href="/rss.xml" />
    <!-- SEO -->
    <meta name="description" content="Contact 0xD3lta Research — Join the Discord server or reach us via encrypted email with PGP." />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="0xD3lta Research" />
    <meta property="og:title" content="Contact | 0xD3lta Research" />
    <meta property="og:description" content="Contact 0xD3lta Research — Join the Discord server or reach us via encrypted email with PGP." />
    <meta property="og:url" content="https://0xdelta.org/contact" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Contact | 0xD3lta Research" />
    <meta name="twitter:description" content="Contact 0xD3lta Research — Join the Discord server or reach us via encrypted email with PGP." />
  </head>

  <body class="min-h-screen bg-neutral-950 text-neutral-400 font-mono">

    <Header client:idle />

    <main class="container mx-auto px-4 py-24 min-h-screen">

      <header class="mb-16 border-b border-neutral-800 pb-12">
        <p class="text-xs font-bold text-neutral-600 mb-6 tracking-[0.2em] uppercase">
            // SECURE_UPLINK
        </p>

        <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 tracking-tighter leading-none uppercase">
            ESTABLISH<br/>CONTACT
        </h1>

        <div class="max-w-2xl border-l-2 border-neutral-800 pl-6">
            <p class="text-lg text-neutral-500 leading-relaxed text-justify">
              Multiple channels available. Use Discord for community discussions and real-time collaboration. For sensitive intel or responsible disclosure, use encrypted email only.
            </p>
        </div>
      </header>

      <SecureContact client:visible />

    </main>

    <Footer client:visible />
  </body>
</html>
