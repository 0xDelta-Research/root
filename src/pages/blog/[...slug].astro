---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Header from '../../components/Header.jsx';
import Footer from '../../components/Footer.jsx';
import { User, Calendar, Clock, ArrowLeft, ArrowRight, Terminal, FileText, Share2, AlertTriangle, Bug, Shield, Activity, Github, Linkedin, Globe, Twitter, Fingerprint, Crosshair, Radio, ScanEye, ExternalLink } from 'lucide-react';
import '../../styles/global.css';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  const sorted = blogEntries.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return sorted.map((entry, index) => ({
    params: { slug: (entry as any).slug || entry.id },
    props: {
      entry,
      prevPost: sorted[index + 1] ?? null,
      nextPost: sorted[index - 1] ?? null,
    },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
  prevPost: CollectionEntry<'blog'> | null;
  nextPost: CollectionEntry<'blog'> | null;
}

const { entry, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(entry);

const readTime = Math.ceil((entry.body || "").length / 2000);

// Ref ID determinístico baseado no ID do post (não muda entre carregamentos)
const refId = String(entry.id.split('').reduce((acc, c) => acc + c.charCodeAt(0), 0) % 9000 + 1000).padStart(4, '0');

// --- LÓGICA DE AUTOR ---
const allTeam = await getCollection('team');
const authorProfile = allTeam.find(
  member => member.data.name.toLowerCase() === entry.data.author.toLowerCase()
);

const IconMap: Record<string, any> = {
  'Bug': Bug, 'Shield': Shield, 'Activity': Activity, 'Terminal': Terminal,
  'Fingerprint': Fingerprint, 'Crosshair': Crosshair, 'Globe': Globe, 'Radio': Radio, 'ScanEye': ScanEye
};

const AuthorIcon = authorProfile && authorProfile.data.icon in IconMap 
  ? IconMap[authorProfile.data.icon as keyof typeof IconMap] 
  : Terminal;

// --- LÓGICA DO ÍNDICE ---
interface HeadingNode {
  depth: number;
  slug: string;
  text: string;
  subheadings: HeadingNode[];
}

const nestedHeadings: HeadingNode[] = [];

headings.forEach((h: any) => {
  if (h.depth === 2) {
    nestedHeadings.push({ ...h, subheadings: [] });
  } else if (h.depth === 3 && nestedHeadings.length > 0) {
    nestedHeadings[nestedHeadings.length - 1].subheadings.push({ ...h, subheadings: [] });
  }
});
---

<html lang="en">
<head>
    <title>{entry.data.title} | 0xD3lta Research</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/delta-favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="0xD3lta Research" href="/rss.xml" />
    <!-- SEO -->
    <meta name="description" content={entry.data.description} />
    <meta name="author" content={entry.data.author} />
    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="0xD3lta Research" />
    <meta property="og:title" content={entry.data.title} />
    <meta property="og:description" content={entry.data.description} />
    <meta property="og:url" content={`https://0xdelta.org/blog/${(entry as any).slug || entry.id}`} />
    <meta property="og:image" content={entry.data.image ?? 'https://0xdelta.org/delta-favicon.png'} />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={entry.data.title} />
    <meta name="twitter:description" content={entry.data.description} />
    <meta name="twitter:image" content={entry.data.image ?? 'https://0xdelta.org/delta-favicon.png'} />
</head>

<body class="min-h-screen bg-[#050505] text-neutral-400 font-mono selection:bg-neutral-800 selection:text-white">

    {/* Barra de progresso de leitura */}
    <div id="reading-progress" class="fixed top-0 left-0 h-[2px] z-[100] w-0 transition-none"
      style={`background: ${entry.data.team === 'Red Team' ? '#ef4444' : '#3b82f6'}`}
    ></div>

    <Header client:idle />

    <main class="container mx-auto px-4 py-12">
        
        {/* Botão Voltar */}
        <div class="mb-8">
            <a href="/blog" class="group inline-flex items-center gap-2 text-xs font-bold text-neutral-500 hover:text-white transition-colors uppercase tracking-widest border-b border-transparent hover:border-white pb-1">
                <ArrowLeft className="w-3 h-3 group-hover:-translate-x-1 transition-transform" />
                Return_To_Archive
            </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
            
            {/* --- SIDEBAR ESQUERDA (ÍNDICE) --- */}
            <aside class="hidden lg:block lg:col-span-3 sticky top-32">
                <div class="border border-neutral-800 bg-neutral-900/30 p-5 backdrop-blur-sm">
                    <div class="flex items-center gap-2 text-xs text-white font-bold border-b border-neutral-800 pb-3 mb-4 uppercase tracking-widest">
                        <Terminal className="w-3 h-3" />
                        Contents_Index
                    </div>
                    
                    {nestedHeadings.length > 0 ? (
                        <nav>
                            <ul class="space-y-1">
                                {nestedHeadings.map((h2) => (
                                    <li class="text-xs">
                                        <a 
                                            href={`#${h2.slug}`} 
                                            class="toc-link block py-1.5 truncate border-l-2 border-transparent pl-3 transition-all duration-300 font-bold text-neutral-500 hover:text-white hover:border-white"
                                            data-target={h2.slug}
                                        >
                                            {h2.text}
                                        </a>
                                        
                                        {/* Subtítulos H3 */}
                                        {h2.subheadings.length > 0 && (
                                            <ul class="pl-4 border-l border-neutral-800 ml-2 mt-1 mb-2 space-y-1">
                                                {h2.subheadings.map((h3: HeadingNode) => (
                                                    <li>
                                                        <a 
                                                            href={`#${h3.slug}`}
                                                            class="toc-link block py-1 text-neutral-600 hover:text-neutral-300 truncate transition-colors"
                                                            data-target={h3.slug}
                                                        >
                                                            {h3.text}
                                                        </a>
                                                    </li>
                                                ))}
                                            </ul>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        </nav>
                    ) : (
                        <p class="text-xs text-neutral-600 italic">No structure data.</p>
                    )}

                    {/* Metadata Box */}
                    <div class="mt-8 pt-6 border-t border-neutral-800">
                        <div class="text-[10px] text-neutral-600 uppercase tracking-widest mb-3">Target Tags</div>
                        <div class="flex flex-wrap gap-2">
                            {entry.data.tags?.map((tag: string) => (
                                <a
                                    href={`/blog?search=${encodeURIComponent(tag)}`}
                                    class="text-[10px] text-neutral-500 border border-neutral-800 bg-neutral-950 px-1.5 py-0.5 hover:text-white hover:border-neutral-500 transition-colors"
                                >
                                    {tag}
                                </a>
                            ))}
                        </div>
                    </div>
                </div>
            </aside>

            {/* --- CONTEÚDO PRINCIPAL --- */}
            <article class="lg:col-span-9 max-w-4xl border-l border-neutral-900/50 pl-0 lg:pl-12 lg:border-l lg:border-neutral-900">
                
                {/* Header do Artigo */}
                <header class="mb-12 border-b border-neutral-800 pb-10">

                    <div class="flex justify-between items-start mb-6">
                        <div class="flex items-center gap-2 text-neutral-600 text-[10px] uppercase tracking-[0.2em]">
                            <FileText className="w-4 h-4" />
                            {/* Slug visual */}
                            <span>Declassified Report // {(entry as any).slug || entry.id}</span>
                        </div>

                        {/* BADGE DE RISCO */}
                        {entry.data.risk && (
                            <div class={`flex items-center gap-2 px-3 py-1 text-xs font-bold uppercase tracking-widest border rounded-sm ${
                                entry.data.risk === 'CRITICAL' ? 'border-red-500 text-red-500 bg-red-950/10 animate-pulse' :
                                entry.data.risk === 'HIGH' ? 'border-orange-500 text-orange-500 bg-orange-950/10 animate-pulse' :
                                entry.data.risk === 'MEDIUM' ? 'border-yellow-500 text-yellow-500 bg-yellow-950/10 animate-pulse' :
                                entry.data.risk === 'INFO' ? 'border-green-500 text-green-500 bg-green-950/10 animate-pulse' :
                                'border-blue-500 text-blue-500 bg-blue-950/10 animate-pulse'
                            }`}>
                                <AlertTriangle className="w-3 h-3" />
                                {entry.data.risk}
                            </div>
                        )}
                    </div>

                    <div class="flex flex-wrap items-center gap-3 mb-6">
                        <span class={`px-2 py-0.5 text-[10px] font-bold uppercase border ${entry.data.team === 'Red Team' ? 'border-red-900 text-red-500 bg-red-950/10' : 'border-blue-900 text-blue-500 bg-blue-950/10'}`}>
                            {entry.data.team}
                        </span>
                        <span class="text-neutral-600 text-xs">/</span>
                        <span class="text-xs text-neutral-400 uppercase tracking-widest">
                            {entry.data.category}
                        </span>
                        {entry.data.repoLink && (
                            <>
                                <span class="text-neutral-600 text-xs">/</span>
                                <a
                                    href={entry.data.repoLink}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="flex items-center gap-1 text-[10px] font-bold uppercase border border-neutral-800 px-2 py-0.5 text-neutral-500 hover:text-white hover:border-neutral-400 transition-colors"
                                >
                                    <ExternalLink className="w-3 h-3" /> Repository
                                </a>
                            </>
                        )}
                    </div>

                    <h1 class="text-3xl md:text-5xl font-bold text-white mb-8 leading-tight tracking-tight uppercase">
                        {entry.data.title}
                    </h1>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-xs font-mono bg-neutral-900/30 p-4 border border-neutral-800">
                        <div>
                            <span class="text-neutral-600 block mb-1 uppercase tracking-wider">Operator</span>
                            <span class="text-white font-bold flex items-center gap-2">
                                <User className="w-3 h-3" /> {entry.data.author}
                            </span>
                        </div>
                        <div>
                            <span class="text-neutral-600 block mb-1 uppercase tracking-wider">Date Logged</span>
                            <span class="text-neutral-400 flex items-center gap-2">
                                <Calendar className="w-3 h-3" /> {entry.data.pubDate.toISOString().split('T')[0]}
                            </span>
                        </div>
                        <div>
                            <span class="text-neutral-600 block mb-1 uppercase tracking-wider">Est. Read</span>
                            <span class="text-neutral-400 flex items-center gap-2">
                                <Clock className="w-3 h-3" /> {readTime} MIN
                            </span>
                        </div>
                        <div>
                            <span class="text-neutral-600 block mb-1 uppercase tracking-wider">Ref ID</span>
                            <span class="text-neutral-400 flex items-center gap-2">
                                <FileText className="w-3 h-3" /> #{refId}
                            </span>
                        </div>
                    </div>
                </header>

                {/* Corpo do Texto (Markdown Renderizado) */}
                <div class="article-content mb-20" id="article-body">
                    <Content />
                </div>

                {/* --- CARD DO AUTOR --- */}
                {authorProfile && (
                    <div class="border-t border-neutral-800 pt-12 mt-12">
                        <div class={`bg-neutral-900/20 border border-neutral-800 p-8 flex flex-col md:flex-row gap-8 items-start md:items-center relative overflow-hidden group transition-all duration-300 ${entry.data.team === 'Red Team' ? 'hover:border-red-500 hover:shadow-[0_0_30px_-5px_rgba(220,38,38,0.3)] hover:bg-red-950/20' : 'hover:border-blue-500 hover:shadow-[0_0_30px_-5px_rgba(59,130,246,0.3)] hover:bg-blue-950/20'}`}>
                            {/* Link absoluto para a página do autor */}
                            <a href={`/team/${authorProfile.id}`} class="absolute inset-0 z-0" aria-label={`View ${authorProfile.data.name}'s profile`}></a>

                            <div class={`w-20 h-20 bg-neutral-950 border border-neutral-700 flex items-center justify-center shrink-0 transition-all duration-300 ${entry.data.team === 'Red Team' ? 'group-hover:bg-red-500/10 group-hover:border-red-500' : 'group-hover:bg-blue-500/10 group-hover:border-blue-500'}`}>
                                <AuthorIcon className={`w-8 h-8 text-neutral-400 transition-colors ${entry.data.team === 'Red Team' ? 'group-hover:text-red-400' : 'group-hover:text-blue-400'}`} />
                            </div>

                            <div class="flex-1">
                                <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
                                    <div>
                                        <p class="text-[10px] text-neutral-500 uppercase tracking-[0.2em] mb-1">Authenticated Operator</p>
                                        <h3 class="text-xl font-bold text-white uppercase tracking-wider mb-2">
                                            {authorProfile.data.name}
                                        </h3>
                                        <div class="inline-flex items-center gap-2 px-2 py-0.5 bg-neutral-950 border border-neutral-800 text-[10px] text-neutral-400 font-mono mb-3">
                                            <span class="w-1.5 h-1.5 rounded-full bg-green-500 shadow-[0_0_5px_rgba(34,197,94,0.8)]"></span>
                                            {authorProfile.data.role}
                                        </div>
                                        {authorProfile.data.bio && (
                                            <p class="text-xs text-neutral-500 leading-relaxed max-w-sm">
                                                {authorProfile.data.bio}
                                            </p>
                                        )}
                                    </div>

                                    {/* Links */}
                                    <div class="flex gap-4 relative z-10">
                                        {authorProfile.data.social?.github && (
                                            <a href={authorProfile.data.social.github} target="_blank" rel="noopener noreferrer" class="text-neutral-600 hover:text-white transition-colors">
                                                <Github className="w-5 h-5" />
                                            </a>
                                        )}
                                        {authorProfile.data.social?.linkedin && (
                                            <a href={authorProfile.data.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-neutral-600 hover:text-white transition-colors">
                                                <Linkedin className="w-5 h-5" />
                                            </a>
                                        )}
                                        {authorProfile.data.social?.website && (
                                            <a href={authorProfile.data.social.website} target="_blank" rel="noopener noreferrer" class="text-neutral-600 hover:text-white transition-colors">
                                                <Globe className="w-5 h-5" />
                                            </a>
                                        )}
                                        {authorProfile.data.social?.discord && (
                                            <span title={`Discord: ${authorProfile.data.social.discord}`} class="text-neutral-600 hover:text-[#5865F2] transition-colors cursor-default">
                                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.04.034.05a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                                            </span>
                                        )}
                                    </div>
                                </div>
                                
                                {/* Skills */}
                                <div class="flex flex-wrap gap-2 mt-2">
                                    {authorProfile.data.skills.map((skill: string) => (
                                        <span class="text-[9px] text-neutral-500 uppercase border-b border-neutral-800 pb-0.5">
                                            {skill}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </div>
                )}

                {/* Navegação Prev / Next */}
                {(prevPost || nextPost) && (
                    <div class="border-t border-neutral-800 pt-8 mt-12 grid grid-cols-1 md:grid-cols-2 gap-4">
                        {prevPost ? (
                            <a
                                href={`/blog/${(prevPost as any).slug || prevPost.id}`}
                                class="group flex flex-col gap-1 p-4 border border-neutral-800 hover:border-neutral-600 bg-neutral-900/20 hover:bg-neutral-900/40 transition-all"
                            >
                                <span class="text-[9px] text-neutral-600 uppercase tracking-widest flex items-center gap-1">
                                    <ArrowLeft className="w-3 h-3" /> Previous
                                </span>
                                <span class="text-xs font-bold text-neutral-400 group-hover:text-white transition-colors line-clamp-2 leading-snug">
                                    {prevPost.data.title}
                                </span>
                            </a>
                        ) : <div />}

                        {nextPost ? (
                            <a
                                href={`/blog/${(nextPost as any).slug || nextPost.id}`}
                                class="group flex flex-col gap-1 p-4 border border-neutral-800 hover:border-neutral-600 bg-neutral-900/20 hover:bg-neutral-900/40 transition-all text-right md:ml-auto w-full"
                            >
                                <span class="text-[9px] text-neutral-600 uppercase tracking-widest flex items-center gap-1 justify-end">
                                    Next <ArrowRight className="w-3 h-3" />
                                </span>
                                <span class="text-xs font-bold text-neutral-400 group-hover:text-white transition-colors line-clamp-2 leading-snug">
                                    {nextPost.data.title}
                                </span>
                            </a>
                        ) : <div />}
                    </div>
                )}

                {/* Rodapé */}
                <div class="border-t border-neutral-800 pt-8 flex justify-between items-center mt-8">
                    <div class="text-xs text-neutral-600 font-mono">
                        END OF REPORT // {(entry as any).slug || entry.id}...
                    </div>
                    <button id="share-button" class="flex items-center gap-2 text-xs font-bold text-black bg-white px-4 py-2 hover:bg-neutral-300 transition-colors uppercase tracking-widest">
                        <Share2 className="w-3 h-3" /> Share Intel
                    </button>
                </div>

            </article>

        </div>
    </main>

    <Footer client:visible />

    {/* --- LIGHTBOX --- */}
    <div id="image-lightbox" class="hidden fixed inset-0 z-[9999] bg-black/95 flex-col items-center justify-center p-4 cursor-zoom-out backdrop-blur-sm transition-opacity duration-300">
        <img id="lightbox-img" src="" alt="Evidence" class="max-w-full max-h-[85vh] border border-white/20 shadow-2xl object-contain" />
        <div class="mt-4 text-white font-mono text-xs flex items-center gap-2 bg-neutral-900 px-3 py-1 rounded border border-neutral-800">
            <span class="animate-pulse text-red-500">●</span> IMAGE_PREVIEW_MODE // CLICK TO CLOSE
        </div>
    </div>

    {/* --- SCRIPTS --- */}
    <script>
        // Barra de progresso de leitura
        const progressBar = document.getElementById('reading-progress') as HTMLElement | null;
        if (progressBar) {
            const update = () => {
                const scrollTop = window.scrollY;
                const docHeight = document.documentElement.scrollHeight - window.innerHeight;
                const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
                progressBar.style.width = pct + '%';
            };
            window.addEventListener('scroll', update, { passive: true });
            update();
        }

        document.addEventListener('DOMContentLoaded', () => {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    const id = entry.target.getAttribute('id');
                    if (!id) return;
                    const link = document.querySelector(`.toc-link[data-target="${id}"]`);
                    if (entry.isIntersecting && link) {
                        document.querySelectorAll('.toc-link').forEach(l => {
                            l.classList.remove('toc-active');
                            l.classList.remove('text-white');
                            l.classList.add('text-neutral-500');
                        });
                        link.classList.add('toc-active');
                        link.classList.remove('text-neutral-500');
                        link.classList.add('text-white');
                    }
                });
            }, { rootMargin: '-100px 0px -60% 0px' });

            document.querySelectorAll('.article-content h2, .article-content h3').forEach(heading => {
                observer.observe(heading);
            });
        });

        document.querySelectorAll('pre').forEach((pre) => {
            const button = document.createElement('button');
            button.className = 'copy-button';
            button.innerHTML = `<span>COPY</span>`;
            button.addEventListener('click', () => {
                const codeElement = pre.querySelector('code');
                if (!codeElement) return;
                const code = codeElement.innerText;
                navigator.clipboard.writeText(codeElement.innerText);
                const originalHtml = button.innerHTML;
                button.innerHTML = `<span style="color:#fff">COPIED</span>`;
                button.style.borderColor = '#fff';
                setTimeout(() => {
                    button.innerHTML = originalHtml;
                    button.style.borderColor = 'rgba(64, 64, 64, 0.5)';
                }, 2000);
            });
            pre.style.position = 'relative';
            pre.appendChild(button);
        });

        const lightbox = document.getElementById('image-lightbox');
        const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
        
        document.querySelectorAll('.article-content img').forEach((element) => {
            const img = element as HTMLImageElement;
            img.style.cursor = 'zoom-in';
            img.title = "Click to analyze evidence";
            img.addEventListener('click', (e) => {
                const target = e.target as HTMLImageElement;
                if (lightbox && lightboxImg && target) {
                    e.stopPropagation();
                    lightboxImg.src = target.src;
                    lightbox.classList.remove('hidden');
                    lightbox.classList.add('flex');
                }
            });
        });

        if (lightbox) {
            lightbox.addEventListener('click', () => {
                lightbox.classList.add('hidden');
                lightbox.classList.remove('flex');
                if(lightboxImg) lightboxImg.src = '';
            });
        }
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && lightbox && !lightbox.classList.contains('hidden')) {
                lightbox.classList.add('hidden');
                lightbox.classList.remove('flex');
            }
        });

        // Share button
        const shareBtn = document.getElementById('share-button');
        if (shareBtn) {
            shareBtn.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(window.location.href);
                    const original = shareBtn.innerHTML;
                    shareBtn.innerHTML = `<span>URL_COPIED</span>`;
                    shareBtn.style.background = '#262626';
                    shareBtn.style.color = '#fff';
                    setTimeout(() => {
                        shareBtn.innerHTML = original;
                        shareBtn.style.background = '';
                        shareBtn.style.color = '';
                    }, 2000);
                } catch {}
            });
        }
    </script>
</body>
</html>

<style is:global>
    /* Estilos do Artigo (PADRÃO DELTA - MONOCROMÁTICO TÁTICO) */
    .article-content {
        color: #d4d4d4; /* neutral-300 */
        line-height: 1.8;
        font-size: 1rem;
    }
    .article-content h2 {
        color: #fff;
        font-size: 1.5rem;
        font-weight: bold;
        margin-top: 3rem;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
