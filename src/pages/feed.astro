---
// Página humana do feed. Substitui a folha XSLT que transformava /rss.xml:
// o Chrome 158 (17/11/2026) desliga XSLT, e a URL passaria a mostrar XML cru.
// O /rss.xml continua sendo o feed para leitores; quem é pessoa cai aqui.
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';

const feedUrl = new URL('/rss.xml', Astro.site).href;
const total = (await getCollection('blog')).length;
---

<html lang="en">
  <head>
    <title>RSS Feed | 0xDelta Research</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/delta-favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="0xDelta Research" href="/rss.xml" />
    <!-- SEO -->
    <meta name="description" content="Subscribe to 0xDelta Research via RSS — every new report lands in your feed reader. No email, no signup." />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="0xDelta Research" />
    <meta property="og:title" content="RSS Feed | 0xDelta Research" />
    <meta property="og:description" content="Subscribe to 0xDelta Research via RSS — every new report lands in your feed reader. No email, no signup." />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="RSS Feed | 0xDelta Research" />
    <meta name="twitter:description" content="Subscribe to 0xDelta Research via RSS — every new report lands in your feed reader. No email, no signup." />
  </head>

  <body class="min-h-screen bg-[#050505] text-neutral-400 font-mono">

    <Header client:idle />

    <main class="container mx-auto px-4 py-24 min-h-screen">

      <header class="mb-16 border-b border-neutral-800 pb-12">
        <p class="text-xs font-bold text-neutral-600 mb-6 tracking-[0.2em] uppercase">
          // RSS_FEED
        </p>
        <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 tracking-tighter leading-none uppercase">
          SUBSCRIBE<br/>VIA RSS
        </h1>
        <div class="max-w-2xl border-l-2 border-neutral-800 pl-6">
          <p class="text-lg text-neutral-500 leading-relaxed">
            Paste the address below into a feed reader — Feedly, NetNewsWire, Thunderbird, or a Discord/Slack bot — and every new report lands there automatically.
          </p>
        </div>
      </header>

      <div class="max-w-2xl border border-neutral-800 bg-neutral-900/40 p-8 flex flex-col gap-6">
        <div>
          <p class="text-[10px] font-bold text-neutral-600 uppercase tracking-widest mb-2">// FEED_ADDRESS</p>
          <a
            href="/rss.xml"
            class="block border border-neutral-800 bg-neutral-950 px-4 py-3 text-sm text-neutral-200 break-all hover:border-neutral-500 hover:text-white transition-colors"
          >
            {feedUrl}
          </a>
        </div>
        <p class="text-sm text-neutral-500 leading-relaxed">
          No email, no signup, nothing collected. You subscribe; we never learn who you are.
        </p>
        <a href="/blog" class="text-xs font-bold text-neutral-600 hover:text-neutral-300 transition-colors uppercase tracking-widest">
          {total} reports in the feed — browse the archive -&gt;
        </a>
      </div>

    </main>

    <Footer client:visible />
  </body>
</html>
