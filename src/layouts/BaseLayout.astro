---
// Único <head> do site. SEO, Open Graph e Twitter saem daqui para todas as
// páginas: antes cada página copiava o próprio <head> e eles divergiam.
import '../styles/global.css';
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';

interface Props {
  title: string;
  description: string;
  // Título/descrição dos cards de redes sociais; padrão: title/description.
  socialTitle?: string;
  socialDescription?: string;
  type?: 'website' | 'article' | 'profile';
  // URL absoluta de uma imagem 1200x630; padrão: card do site (/og/site.png).
  image?: string;
  // Páginas fora do índice (404): noindex, sem canonical nem og:url.
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  socialTitle = title,
  socialDescription = description,
  type = 'website',
  image = new URL('/og/site.png', Astro.site).href,
  noindex = false,
  bodyClass = 'min-h-screen bg-[#050505] text-neutral-400 font-mono',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/delta-favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="0xDelta Research" href="/rss.xml" />
    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="0xDelta Research" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={image} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <Header client:idle />
    <slot />
    <Footer />
  </body>
</html>
