name: 0xDelta News Bot

on:
  schedule:
    - cron: '0 */2 * * *'   # roda a cada 2 horas
  workflow_dispatch:          # permite rodar manualmente também

jobs:
  run-bot:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: pip install requests feedparser

      - name: Restore seen entries cache
        uses: actions/cache@v4
        with:
          path: seen_entries.json
          key: seen-entries-${{ github.run_id }}
          restore-keys: seen-entries-

      - name: Run news bot
        env:
          DISCORD_TOKEN: ${{ secrets.DISCORD_TOKEN }}
          NEWS_CHANNEL_ID: ${{ secrets.NEWS_CHANNEL_ID }}
        run: python 0xdelta_news_bot.py --quiet
